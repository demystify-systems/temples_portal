 {
  "id": "trilok-teerth-dham-bada-gaon",
  "name": "Trilok Teerth Dham",
  "country": "India",
  "state": "Uttar Pradesh",
  "place": "Bada Gaon, Baghpat district",
  "lat": 28.8774,
  "lng": 77.3337,
