 {
  "id": "bhavaniswar-baranagar",
  "name": "Bhavaniswar Mandir",
  "country": "India",
  "state": "West Bengal",
  "place": "Baranagar, Murshidabad district",
  "lat": 24.2520,
  "lng": 88.2432,
