 {
  "id": "kalachand-bishnupur",
  "name": "Kalachand Temple",
  "country": "India",
  "state": "West Bengal",
  "place": "Bishnupur, Bankura",
  "lat": 23.0592,
  "lng": 87.3250,
  "tradition": "Hindu",
  "deity": "Krishna (Kalachand)",
  "built": [1656, 1656],
  "builtDisplay": "1656 (Malla)",
  "dynasty": "Malla",
  "style": "Ek-ratna (Bengal temple architecture)",
  "circuits": [],
  "significance": "Founded in 1656 by Raghunath Singha Dev of Mallabhum, this south-facing laterite shrine is the earliest surviving eka-ratna temple at Bishnupur, about 11 m square with a corridor and three arched openings on each side. Low-relief carving covers it with Krishna-lila episodes, Puranic deities, ascetics and dancers.",
  "wiki": "https://en.wikipedia.org/wiki/Kalachand_Temple",
  "sources": [
   {"l": "Wikipedia", "u": "https://en.wikipedia.org/wiki/Kalachand_Temple"},
