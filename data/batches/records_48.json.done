  "tier": "compact"
 },
 {
  "id": "char-bangla-baranagar",
  "name": "Char Bangla Temples",
  "country": "India",
  "state": "West Bengal",
  "place": "Baranagar, Murshidabad district",
  "lat": 24.2514,
  "lng": 88.2437,
  "tradition": "Hindu",
  "deity": "Shiva",
  "built": [1760, 1760],
  "builtDisplay": "1760 (Rani Bhabani of Natore)",
  "dynasty": "Natore Raj",
  "style": "Ek-bangla (Bengal temple architecture)",
  "circuits": [],
  "significance": "Four 18th-century Shiva temples at Baranagar built under the patronage of Rani Bhabani of Natore, the northern one dated 1760. Two carry rich terracotta facades of mythological and everyday scenes, one is finished in incised plaster and one is plain; shifting courses of the Ganges now run within yards of the ASI-protected group.",
  "wiki": "https://en.wikipedia.org/wiki/Char_Bangla_Temples",
  "sources": [
   {"l": "Wikipedia", "u": "https://en.wikipedia.org/wiki/Char_Bangla_Temples"},
