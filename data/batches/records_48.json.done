  ],
  "verified": "wikipedia-2026-08-27",
  "tier": "compact"
 },
 {
  "id": "sai-baba-dilsukhnagar",
  "name": "Sai Baba Temple, Dilsukhnagar",
  "country": "India",
  "state": "Telangana",
