 {
  "id": "madan-mohan-bishnupur",
  "name": "Madan Mohan Temple, Bishnupur",
  "country": "India",
  "state": "West Bengal",
  "place": "Bishnupur, Bankura",
  "lat": 23.0807,
  "lng": 87.3236,
  "tradition": "Hindu",
