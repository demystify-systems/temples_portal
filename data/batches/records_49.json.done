  "country": "India",
  "state": "Uttarakhand",
  "place": "Hanol, Dehradun district",
  "lat": 30.9713,
  "lng": 77.9278,
  "tradition": "Hindu",
  "deity": "Shiva, worshipped locally as Mahasu Devta",
