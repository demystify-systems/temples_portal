 {
  "id": "thirunadhikkara-cave-temple",
  "name": "Thirunadhikkara Cave Temple",
  "country": "India",
  "state": "Tamil Nadu",
  "place": "Thirunanthikarai, Kanyakumari district",
  "lat": 8.399,
  "lng": 77.2975,
  "tradition": "Hindu",
  "deity": "Shiva",
  "built": [
