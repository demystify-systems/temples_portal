 {
  "id": "ramana-ashram-tiruvannamalai",
  "name": "Sri Ramana Ashram",
  "country": "India",
  "state": "Tamil Nadu",
  "place": "Tiruvannamalai",
  "lat": 12.2241,
  "lng": 79.0568,
  "tradition": "Hindu",
  "deity": "Samadhi of Ramana Maharshi; Shiva",
  "built": [1922, 1949],
  "builtDisplay": "founded 1922; temple 1939-1949",
  "dynasty": "Modern",
  "circuits": [],
  "significance": "An Advaita Vedanta ashram at the foot of Arunachala hill, which grew from December 1922 around the samadhi shrine of Ramana Maharshi's mother and became the seat of his teaching. The guru's own body is enshrined in a samadhi hall on the campus, beside a temple built between 1939 and 1949 by the sthapati Vaidyanatha.",
  "website": "https://www.gururamana.org/",
  "wiki": "https://en.wikipedia.org/wiki/Sri_Ramana_Ashram",
  "sources": [
   { "l": "Wikipedia", "u": "https://en.wikipedia.org/wiki/Sri_Ramana_Ashram" },
   { "l": "Wikidata Q7586214", "u": "https://www.wikidata.org/wiki/Q7586214" },
   { "l": "Official site", "u": "https://www.gururamana.org/" }
  ],
  "verified": "wikipedia-2026-08-27",
  "tier": "compact"
 },
 {
  "id": "sri-aurobindo-ashram-puducherry",
  "name": "Sri Aurobindo Ashram",
  "country": "India",
  "state": "Puducherry",
  "place": "Puducherry",
  "lat": 11.9367,
  "lng": 79.8340,
  "tradition": "Hindu",
  "deity": "Samadhi of Sri Aurobindo and the Mother",
  "built": [1926, 1926],
  "builtDisplay": "founded 1926",
  "dynasty": "Modern",
  "circuits": [],
  "significance": "A spiritual community founded on 24 November 1926 by Sri Aurobindo and Mirra Alfassa (the Mother) in the former French quarter of Puducherry, formed around his Integral Yoga. Its central shrine is a white-marble samadhi in which both their bodies are laid to rest.",
  "wiki": "https://en.wikipedia.org/wiki/Sri_Aurobindo_Ashram",
  "sources": [
   { "l": "Wikipedia", "u": "https://en.wikipedia.org/wiki/Sri_Aurobindo_Ashram" },
   { "l": "Wikidata Q303682", "u": "https://www.wikidata.org/wiki/Q303682" }
  ],
