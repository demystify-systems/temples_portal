  "tier": "compact"
 },
 {
  "id": "sani-monastery-zanskar",
  "name": "Sani Monastery",
  "country": "India",
  "state": "Ladakh",
  "place": "Sani, Zanskar",
  "lat": 33.5053,
  "lng": 76.8103,
  "tradition": "Buddhist",
  "deity": "Padmasambhava",
  "built": [100, 200],
  "builtDisplay": "traditionally 2nd c. (Kushan)",
  "dynasty": "Kushan",
  "circuits": [],
  "significance": "A Drukpa Kagyu monastery in the Zanskar valley of Ladakh, a few kilometres from Padum, whose foundation is traditionally carried back to the Kushan emperor Kanishka. It is unusual among Zanskar gompas in standing on flat ground rather than a crag, and encloses the ancient Kanika stupa.",
  "story": "Padmasambhava is said to have spent five years in a small chapel at the site, and the monastery is also linked in tradition to the yogi Naropa and to the epic king Gesar.",
  "wiki": "https://en.wikipedia.org/wiki/Sani_Monastery",
  "sources": [
   {"l": "Wikipedia", "u": "https://en.wikipedia.org/wiki/Sani_Monastery"},
   {"l": "Wikidata Q4416145", "u": "https://www.wikidata.org/wiki/Q4416145"}
  ],
  "verified": "wikipedia-2026-08-27",
  "tier": "compact"
 },
 {
  "id": "devipuram-anakapalli",
  "name": "Devipuram",
  "country": "India",
  "state": "Andhra Pradesh",
  "place": "Devipuram, near Visakhapatnam",
  "lat": 17.7654,
  "lng": 83.083,
