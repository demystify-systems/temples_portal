 {
  "id": "ananthagiri-temple-vikarabad",
  "name": "Ananthagiri Temple",
  "country": "India",
  "state": "Telangana",
  "place": "Ananthagiri, Vikarabad district",
  "lat": 17.3099,
  "lng": 77.8628,
  "tradition": "Hindu",
  "deity": "Vishnu as Anantha Padmanabha Swamy",
  "built": [1600, 1700],
  "builtDisplay": "c. 17th c. (Nizam-era patronage)",
  "dynasty": "Nizams of Hyderabad",
  "style": "South Indian",
  "circuits": [],
  "significance": "A hill temple to Vishnu in the Ananthagiri forest of Vikarabad district, Telangana, dated by the article to roughly four centuries ago and endowed by the Nizams, with the seventh Nizam Mir Osman Ali Khan funding work there. The hills around it are the source of the Musi river.",
  "story": "Tradition says the deity appeared to a Nizam in a dream asking that a temple be raised, and earlier that the sage Markandeya installed the image here and had the Ganga brought for his bathing.",
  "wiki": "https://en.wikipedia.org/wiki/Ananthagiri_Temple",
  "sources": [
   {"l": "Wikipedia", "u": "https://en.wikipedia.org/wiki/Ananthagiri_Temple"},
   {"l": "Wikidata Q4751480", "u": "https://www.wikidata.org/wiki/Q4751480"}
  ],
  "verified": "wikipedia-2026-08-27",
  "tier": "compact"
 },
 {
  "id": "ananta-shayana-saranga",
  "name": "Ananta Shayana",
  "country": "India",
  "state": "Odisha",
  "place": "Saranga, Dhenkanal district",
  "lat": 20.9287,
  "lng": 85.2469,
  "tradition": "Hindu",
  "deity": "Vishnu, reclining as Anantashayana",
  "built": [800, 825],
  "builtDisplay": "early 9th c. (Bhauma-Kara)",
  "dynasty": "Bhauma-Kara",
  "circuits": [],
  "significance": "A colossal rock-cut image of the reclining Vishnu at Saranga in Dhenkanal district, Odisha, carved in the first quarter of the 9th century under Nandodbhava feudatories of the Bhauma-Kara kings. It is among the largest Vaishnava rock sculptures in eastern India.",
  "story": "The sculpture shows Vishnu asleep on the serpent Ananta upon the cosmic ocean, with a lotus rising from his navel on which Brahma sits creating the world.",
  "wiki": "https://en.wikipedia.org/wiki/Ananta_Shayana",
  "sources": [
   {"l": "Wikipedia", "u": "https://en.wikipedia.org/wiki/Ananta_Shayana"},
   {"l": "Wikidata Q4751447", "u": "https://www.wikidata.org/wiki/Q4751447"}
  ],
  "verified": "wikipedia-2026-08-27",
  "tier": "compact"
 },
 {
  "id": "draupadi-ratha-mahabalipuram",
  "name": "Draupadi Ratha",
  "country": "India",
  "state": "Tamil Nadu",
  "place": "Mahabalipuram",
  "lat": 12.609,
  "lng": 80.1898,
  "tradition": "Hindu",
  "deity": "Durga",
  "built": [630, 680],
  "builtDisplay": "c. 650 (Pallava)",
  "dynasty": "Pallava",
  "style": "Monolithic rock-cut",
  "circuits": [],
  "significance": "The smallest of the Pancha Rathas at Mahabalipuram, cut from a single rock around 650 CE under the Pallavas and shaped like a thatched hut. Its sanctum holds Durga as Mahishasuramardini, and it forms part of the UNESCO-listed monuments of the town.",
  "story": "The monument is popularly named for Draupadi, shared wife of the five Pandavas of the Mahabharata, although the article notes that history does not support the name.",
  "wiki": "https://en.wikipedia.org/wiki/Draupadi_Ratha",
  "sources": [
   {"l": "Wikipedia", "u": "https://en.wikipedia.org/wiki/Draupadi_Ratha"},
   {"l": "Wikidata Q5305938", "u": "https://www.wikidata.org/wiki/Q5305938"}
  ],
  "verified": "wikipedia-2026-08-27",
  "tier": "compact"
 },
 {
  "id": "bhagyalakshmi-hyderabad",
  "name": "Bhagyalakshmi Temple",
  "country": "India",
  "state": "Telangana",
  "place": "Ghansi Bazaar, Hyderabad",
  "lat": 17.3614,
  "lng": 78.4744,
  "tradition": "Hindu",
  "deity": "Bhagyalakshmi, a form of Lakshmi",
  "built": [1960, 1970],
  "builtDisplay": "present structure 1960s",
  "dynasty": "Modern",
  "circuits": [],
  "significance": "A small shrine to Lakshmi abutting the south-east minaret of the Charminar in Hyderabad's old city. The structure standing today was put up in the 1960s, and historians hold that the stone it grew around was a guard stone set to protect the monument's corner from traffic.",
  "story": "Local tradition dates the stone to the Qutb Shahi period and links the shrine's name to Bhagmati, the queen after whom the city is said to have first been named.",
  "wiki": "https://en.wikipedia.org/wiki/Bhagyalakshmi_Temple",
  "sources": [
   {"l": "Wikipedia", "u": "https://en.wikipedia.org/wiki/Bhagyalakshmi_Temple"},
   {"l": "Wikidata Q4900712", "u": "https://www.wikidata.org/wiki/Q4900712"}
  ],
  "verified": "wikipedia-2026-08-27",
  "tier": "compact"
 },
 {
  "id": "ashtalakshmi-temple-hyderabad",
  "name": "Ashtalakshmi Temple, Hyderabad",
  "country": "India",
  "state": "Telangana",
  "place": "Kothapet, Hyderabad",
  "lat": 17.3647,
  "lng": 78.5479,
  "tradition": "Hindu",
  "deity": "Ashta Lakshmi, the eight forms of Lakshmi",
  "built": [1991, 1996],
  "builtDisplay": "consecrated 1996",
  "dynasty": "Modern",
  "style": "South Indian",
  "circuits": [],
  "significance": "A temple at Ramakrishnapuram, Kothapet in Hyderabad enshrining Lakshmi in her eight aspects, from Adilakshmi to Varalakshmi. Raised under the auspices of the Kanchi Kamakoti Peetam after five years of work, it was consecrated in April 1996 and follows the plan of the Ashtalakshmi temple in Chennai.",
  "website": "https://ashtalakshmitemple.co.in",
  "wiki": "https://en.wikipedia.org/wiki/Ashtalakshmi_Temple,_Hyderabad",
  "sources": [
   {"l": "Wikipedia", "u": "https://en.wikipedia.org/wiki/Ashtalakshmi_Temple,_Hyderabad"},
   {"l": "Wikidata Q4805941", "u": "https://www.wikidata.org/wiki/Q4805941"},
   {"l": "Official site", "u": "https://ashtalakshmitemple.co.in"}
  ],
  "verified": "wikipedia-2026-08-27",
  "tier": "compact"
 },
 {
