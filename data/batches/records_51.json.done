 {
  "id": "boyakonda-gangamma-annamayya",
  "name": "Boyakonda Gangamma Temple",
  "country": "India",
  "state": "Andhra Pradesh",
  "place": "Diguvapalli, Annamayya district",
  "lat": 13.5676,
  "lng": 78.4632,
  "tradition": "Hindu",
  "deity": "Gangamma Devi, a form of Shakti",
  "built": [1000, 1800],
  "builtDisplay": "dating unrecorded",
  "dynasty": "Undetermined",
  "circuits": [],
  "significance": "A hillside shrine of the goddess Gangamma near Diguvapalli in Annamayya district, Andhra Pradesh, about 20 km from Madanapalle. It is a major regional pilgrimage centre, especially for the Boya and Pala Ekari communities who built and maintain it.",
  "story": "It is said that when those communities resisted the Nawab's forces, the goddess came down from the hillock, sheltered them and destroyed the army, and they raised the temple in her honour.",
  "wiki": "https://en.wikipedia.org/wiki/Boiyakonda_Gangamma_Temple",
  "sources": [
   {"l": "Wikipedia", "u": "https://en.wikipedia.org/wiki/Boiyakonda_Gangamma_Temple"},
