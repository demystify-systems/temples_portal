 {
  "id": "krishna-mandapam-mahabalipuram",
  "name": "Krishna Mandapam",
  "country": "India",
  "state": "Tamil Nadu",
  "place": "Mahabalipuram",
  "lat": 12.6167,
  "lng": 80.1917,
  "tradition": "Hindu",
  "deity": "Krishna",
  "built": [600, 700],
  "builtDisplay": "mid-7th c. (Pallava); mandapa added 16th c.",
  "dynasty": "Pallava",
  "style": "Pallava",
  "circuits": [],
  "significance": "A rock-cut relief panel at Mahabalipuram carved in the mid-7th century under the Pallavas, showing Krishna raising Govardhana amid scenes of cowherd village life. A pillared mandapa was built in front of it in the 16th century under the Vijayanagara empire.",
  "story": "The relief depicts Krishna lifting the Govardhana hill on one finger to shelter the cowherds from the deluge sent by Indra.",
  "wiki": "https://en.wikipedia.org/wiki/Krishna_Mandapam,_Mahabalipuram",
  "sources": [
   {"l": "Wikipedia", "u": "https://en.wikipedia.org/wiki/Krishna_Mandapam,_Mahabalipuram"},
   {"l": "Wikidata Q15240480", "u": "https://www.wikidata.org/wiki/Q15240480"}
  ],
  "verified": "wikipedia-2026-08-27",
  "tier": "compact"
