# Both settings exist for ONE dependency: sarvam-conv-ai-sdk, which ships a
# packaging defect. Removing either re-breaks the install.
#
# The SDK declares its RUNTIME REQUIREMENT as peer dependencies:
#
#   "peerDependencies": { "node": ">=18.0.0", "ws": "...",
#                         "react-native": ">=0.75.0", "react-native-audio-api": ... }
#
# `node` there should have been an `engines` field. npm 7+ installs peers
# automatically, so it resolves `node` to the npm PACKAGE of that name and
# downloads a complete 204 MB Node.js distribution into node_modules — plus a
# React Native toolchain this project has no use for. Measured: node_modules
# went from 246 MB to 569 MB.
legacy-peer-deps=true

# `speaker` and `node-record-lpcm16` are optionalDependencies of the same SDK,
# for its NODE audio interface. This project imports `sarvam-conv-ai-sdk/browser`
# exclusively — verified: zero references to `speaker` in dist/browser.js — and
# `speaker` is a native module wanting node-gyp and ALSA headers, which is a
# build script we do not want running on a deploy image for code that is never
# loaded.
omit=optional

# Result, measured on a clean install: 217 MB, below the 246 MB this project had
# before the SDK was added at all. The browser build is present and intact.
