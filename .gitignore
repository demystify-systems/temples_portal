# generated by scripts/build-search-index.mjs and build-map-artefacts.mjs, both
# of which run in the npm prebuild/predev/pretest hooks — so these are rebuilt
# on every machine from data/ and never need committing.
# NOTE the /* — excluding `src/lib/generated/` (the DIRECTORY) makes git skip
# descending into it entirely, so a later negation can never match anything
# inside. Excluding its CONTENTS is what leaves the negation reachable.
src/lib/generated/*

# ...EXCEPT the UI translations, which are the one generated file that CANNOT be
# regenerated at build time: they need SARVAM_API_KEY and cost a paid call per
# string per language. They are committed on purpose, which is also what makes
# them reviewable by someone who actually reads the language. Vercel's build
# failed exactly here — ignored, absent, and nothing to regenerate it from.
!src/lib/generated/ui-translations.ts

# Playwright MCP browser artifacts — console-*.log and page-*.yml dumps written
# into the repo root by the MCP browser tool during UI checks. Regenerable, and
# they accumulate: 45 files / ~1 MB from a single afternoon of screenshot runs.
.playwright-mcp/
.vercel
.env*
