# Supabase (dormant in v1 — site builds fully static from data/sites.json)
# Fill these when activating the database layer, then run: npm run db:seed
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Feature flags (src/lib/flags.ts). Unset, empty or unrecognised = OFF.
# Accepted "on" spellings: 1, true, on, yes.
# Publishes /support. It gates publication only — this project has no payment
# provider and no payment code, in either state of this flag.
NEXT_PUBLIC_SUPPORT_PAGE=
