# Supabase (dormant in v1 — site builds fully static from data/sites.json)
# Fill these when activating the database layer, then run: npm run db:seed
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Feature flags (src/lib/flags.ts). Unset, empty or unrecognised = OFF.
# Accepted "on" spellings: 1, true, on, yes.
# Publishes /support. It gates publication only — this project has no payment
# provider and no payment code, in either state of this flag.
NEXT_PUBLIC_SUPPORT_PAGE=

# The voice the atlas answers in. One of the names Bulbul offers (see
# KNOWN_SPEAKERS in src/lib/ai/sarvam.ts); unset means Bulbul's default,
# "shubh". An unrecognised name logs a warning and falls back rather than
# taking spoken answers offline.
#
# A CLONED voice cannot be used here yet: as of 2026-08-28 Sarvam's public
# text-to-speech API accepts only its own closed list of speakers, and every
# voice-clone endpoint answers 404. If that changes, the clone's id goes here.
SARVAM_TTS_SPEAKER=
