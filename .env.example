# Supabase (dormant in v1 — site builds fully static from data/sites.json)
# Fill these when activating the database layer, then run: npm run db:seed
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Feature flags (src/lib/flags.ts). Unset, empty or unrecognised = OFF.
# Accepted "on" spellings: 1, true, on, yes.
# Publishes /support. It gates publication only — this project has no payment
# provider and no payment code, in either state of this flag.
NEXT_PUBLIC_SUPPORT_PAGE=

# The voice the atlas answers in. One of the names Bulbul offers (see
# KNOWN_SPEAKERS in src/lib/ai/sarvam.ts); unset means Bulbul's default,
# "shubh". An unrecognised name logs a warning and falls back rather than
# taking spoken answers offline.
#
# A CLONED voice cannot be used here yet: as of 2026-08-28 Sarvam's public
# text-to-speech API accepts only its own closed list of speakers, and every
# voice-clone endpoint answers 404. If that changes, the clone's id goes here.
SARVAM_TTS_SPEAKER=

# --- Sarvam Voice Agents (the spoken assistant) -----------------------------
# All four are needed together; with any of them unset the Speak tab falls back
# to the cited streaming cascade, which still answers only from data/sites.json.
#
# These come from a DIFFERENT dashboard to SARVAM_API_KEY — indus.sarvam.ai/samvaad,
# Settings -> API Key. The platform sk_... key is rejected by Voice Agents.
#
# IMPORTANT, and the reason the UI says so on its face: a Voice Agent's prompt,
# tools and knowledge base are authored in Sarvam's dashboard, not in this repo.
# Answers on that path do NOT come from the cited corpus and are NOT bound by
# CLAUDE.md rule 2. The Type tab is unchanged and still cites everything.
SARVAM_VOICE_AGENT_KEY=
SARVAM_VOICE_AGENT_ORG_ID=
SARVAM_VOICE_AGENT_WORKSPACE_ID=
SARVAM_VOICE_AGENT_APP_ID=

# Which published version of the agent to open. Optional — defaults to 1, which
# is what every agent has. Set it only after publishing a second version.
#
# app-runtime cannot resolve an app without a version and answers
#   404 "App not found for the interaction type"
# which names interaction_type, is present and correct, and says nothing about
# the parameter actually missing. Verified against the live service 2026-08-28:
#   ?interaction_type=call            -> 404
#   ?interaction_type=call&version=1  -> 200
SARVAM_VOICE_AGENT_VERSION=
